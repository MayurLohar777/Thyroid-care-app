# ==============================================================================
# Care Your Thyroid — Environment Configuration
# ==============================================================================

# Core Application
APP_NAME="Care Your Thyroid"
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Client URLs (CORS)
CORS_ORIGINS=["http://localhost:3000","http://localhost:19006","http://localhost:8081"]
WEB_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000

# PostgreSQL Database (Asyncpg for SQLAlchemy 2.0 async engine)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=care_your_thyroid
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/care_your_thyroid
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/care_your_thyroid

# Redis Cache & Session/OTP Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO for Local Development, AWS S3 for Production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=thyroid-reports
S3_REGION=us-east-1
S3_SECURE=false

# Clinical Safety & AI Governance
AI_MODEL_VERSION=v1.0.0-synthetic-benchmark
REQUIRE_OCR_HUMAN_VERIFICATION=true
ENABLE_SYNTHETIC_DATA_LABELING=true
